{
  "name": "developer-productivity-dashboard-backend",
  "version": "1.0.0",
  "description": "Task 2 - Users, Projects & Tasks REST API in Express and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && tsx src/db/seed.ts"
  },
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "rest-api",
    "productivity-dashboard",
    "crud"
  ],
  "author": "Pankaj Prajapati",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
